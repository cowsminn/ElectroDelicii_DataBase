<form action="/angajati/edit/<%= angajat.id_angajat %>" method="post">
    <label for="nume">Nume:</label>
    <input type="text" id="nume" name="nume" value="<%= angajat.nume %>" required>

    <label for="prenume">Prenume:</label>
    <input type="text" id="prenume" name="prenume" value="<%= angajat.prenume %>" required>

    <label for="magazin">Magazin:</label>
    <input type="text" id="magazin" name="magazin" value="<%= angajat.magazin %>" required>

    <label for="data_angajare">Data Angajare:</label>
    <input type="date" id="data_angajare" name="data_angajare" value="<%= angajat.data_angajare.toISOString().split('T')[0] %>" required>

    <label for="salariu">Salariu:</label>
    <input type="number" id="salariu" name="salariu" value="<%= angajat.salariu %>" required>


    <button type="submit">Save Changes</button>
</form>
