<form action="/tranzactii/edit/<%= tranzactie.id_tranzactie %>" method="post">

    <label for="client">Client:</label>
    <input type="text" id="client" name="client" value="<%= tranzactie.client %>" required>

    <label for="produs">Produs:</label>
    <input type="text" id="produs" name="produs" value="<%= tranzactie.produs %>" required>

    <label for="metoda_plata">Metoda_plata:</label>
    <input type="text" id="metoda_plata" name="metoda_plata" value="<%= tranzactie.metoda_plata %>" required>

    <label for="data">Data:</label>
    <input type="date" id="data" name="data" value="<%= tranzactie.data.toISOString().split('T')[0] %>" required>

    <button type="submit">Save Changes</button>
</form>
