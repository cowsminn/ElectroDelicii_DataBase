<form action="/magazine/edit/<%= magazin.id_magazin %>" method="post">

    <label for="nume">Nume:</label>
    <input type="text" id="nume" name="nume" value="<%= magazin.nume %>" required>

    <label for="judet">Judet:</label>
    <input type="text" id="judet" name="judet" value="<%= magazin.judet %>" required>
    
    <label for="oras">Oras:</label>
    <input type="text" id="oras" name="oras" value="<%= magazin.oras %>" required>

    <label for="strada">Strada:</label>
    <input type="text" id="strada" name="strada" value="<%= magazin.strada %>" required>

    <label for="numar">Numar:</label>
    <input type="text" id="numar" name="numar" value="<%= magazin.numar %>" required>

    <label for="cod_postal">Cod_postal:</label>
    <input type="number" id="cod_postal" name="cod_postal" value="<%= magazin.cod_postal %>" required>

    <button type="submit">Save Changes</button>
</form>
