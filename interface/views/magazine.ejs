<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        table, th, td {
            border: 1px solid black;
        }

        th, td {
            padding: 10px;
            text-align: left;
        }

        .sortable {
            cursor: pointer;
        }
        
        .sorted-asc::after {
            content: ' ↑';
        } 

         .sorted-desc::after {
            content: ' ↓';
        } 

    </style>
</head>
<body>
    <h1>Lista Magazinelor</h1>
    <table id="magazineTable">
        <thead>
            <tr>
                <th class="sortable" onclick="sortTable(0)">Id_magazin</th>
                <th class="sortable" onclick="sortTable(1)">Nume</th>
                <th class="sortable" onclick="sortTable(2)">Judet</th>
                <th class="sortable" onclick="sortTable(3)">Oras</th>
                <th class="sortable" onclick="sortTable(4)">Strada</th>
                <th class="sortable" onclick="sortTable(5)">Numar</th>
                <th class="sortable" onclick="sortTable(6)">Cod_postal</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% magazine.forEach(magazin => { %>
                <tr>
                    <td><%= magazin.id_magazin %></td>
                    <td><%= magazin.nume %></td>
                    <td><%= magazin.judet %></td>
                    <td><%= magazin.oras %></td>
                    <td><%= magazin.strada %></td>
                    <td><%= magazin.numar %></td>
                    <td><%= magazin.cod_postal %></td>
                    <td>
                        <a href="/magazine/edit/<%= magazin.id_magazin %>" class="btn btn-primary btn-sm">Edit</a>
                        <a href="/magazine/delete/<%= magazin.id_magazin %>" onclick="return confirm('Are you sure you want to delete this record?')">Delete</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <script>
        const sortOrder = new Array(6).fill('asc');
    
        function sortTable(columnIndex) {
            const table = document.getElementById('magazineTable');
            const rows = Array.from(table.rows).slice(1);
    
            rows.sort((a, b) => {
                const cellA = a.cells[columnIndex].textContent.trim();
                const cellB = b.cells[columnIndex].textContent.trim();
    
                return cellA.localeCompare(cellB, undefined, { numeric: true, sensitivity: 'base' });
            });
    
            if (sortOrder[columnIndex] === 'desc') {
                rows.reverse();
                sortOrder[columnIndex] = 'asc';
            } else {
                sortOrder[columnIndex] = 'desc';
            }
    
            for (const row of rows) {
                table.tBodies[0].appendChild(row);
            }
    
            resetSortIndicators(columnIndex);
            updateSortIndicator(columnIndex, sortOrder[columnIndex]);
        }
    
        function resetSortIndicators(currentColumn) {
            const headers = document.querySelectorAll('#magazineTable th');
    
            headers.forEach((header, index) => {
                if (index !== currentColumn) {
                    header.classList.remove('sorted-asc', 'sorted-desc');
                }
            });
        }
    
        function updateSortIndicator(columnIndex, order) {
            const headers = document.querySelectorAll('#magazineTable th');
    
            headers.forEach((header, index) => {
                if (index === columnIndex) {
                    header.classList.remove('sorted-asc', 'sorted-desc');
                    header.classList.add(`sorted-${order}`);
                } else {
                    header.classList.remove('sorted-asc', 'sorted-desc');
                }
            });
        }
    
        document.addEventListener('DOMContentLoaded', function () {
            sortTable(0);
        });
    </script>
</body>
</html>